# ==== Environment ====
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# ==== Supabase (fill these with your real project values before using cloud DB) ====
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ==== Database ====
# LOCAL DEV (this repo's local Postgres, used for testing right now):
DATABASE_URL=postgresql+asyncpg://app_user:localdevpass@localhost:5432/infosenior_care
MIGRATION_DATABASE_URL=postgresql://app_user:localdevpass@localhost:5432/infosenior_care

# PRODUCTION (Supabase pooler -- swap in when deploying):
# DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# MIGRATION_DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ==== Cache (Valkey -- Redis-protocol compatible, same client library) ====
VALKEY_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=180

# ==== CORS ====
CORS_ORIGINS=["http://localhost:8081","https://your-app-domain.com"]

# ==== Rate limiting ====
RATE_LIMIT_PER_MINUTE=60

# ==== Monitoring ====
SENTRY_DSN=

# ==== Auth providers we officially support (documented, not env-driven) ====
# email | apple | google | guest
